{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulora.local/schemas/competition-core-decision-1.0.0.json",
  "title": "CompetitionCoreDecision",
  "type": "object",
  "required": ["action", "risk_control_advice"],
  "properties": {
    "action": { "type": "integer", "enum": [-1, 0, 1] },
    "risk_control_advice": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": { "enum": ["1", "2", "3", "4", "5", "6", "7", "8", "9"] },
      "uniqueItems": true
    }
  }
}
