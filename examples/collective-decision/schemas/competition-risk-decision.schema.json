{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulora.local/schemas/competition-risk-decision-1.0.0.json",
  "type": "object",
  "required": ["risk_control_advice"],
  "properties": {
    "risk_control_advice": {
      "type": "array", "minItems": 0, "maxItems": 4,
      "items": { "enum": ["1", "2", "3", "4", "5", "6", "7", "8", "9"] }, "uniqueItems": true
    },
    "risk_reason": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
