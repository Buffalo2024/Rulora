{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rulora.local/schemas/debate-broadcast-payload-1.0.0.json",
  "title": "DebateBroadcastPayload",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["执行员", "经营调整方向", "逻辑", "证据"],
      "properties": {
        "执行员": { "type": "string", "minLength": 1 },
        "经营调整方向": { "enum": ["risk_up", "risk_flat", "risk_down"] },
        "逻辑": { "type": "array", "minItems": 1, "maxItems": 6 },
        "证据": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["执行员", "风控建议", "逻辑", "证据"],
      "properties": {
        "执行员": { "type": "string", "minLength": 1 },
        "风控建议": {
          "type": "array",
          "items": { "enum": ["1", "2", "3", "4", "5", "6", "7", "8", "9"] },
          "uniqueItems": true
        },
        "逻辑": { "type": "array", "minItems": 1, "maxItems": 6 },
        "证据": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  ]
}
