# Only synthetic/demo runs are enabled by default.
# npm run example uses a scripted provider; npm run web does NOT simulate live analysis.
# Shell environment must be exported explicitly; this file is not loaded automatically.
# AGENT_MODEL_CONFIG=config/model-profiles.local.json
# CHAIN_LLM_API_KEY=
# CHAIN_LLM_MODEL=
# CHAIN_LLM_BASE_URL=
# Set the other role variables listed in config/model-profiles.example.json too.
# RULORA_PRIVACY_PASSWORD=choose-your-own-display-unlock-password
# Presentation masking is NOT authentication or server-side redaction.
