{
  "name": "@rulora/core",
  "version": "0.1.0-alpha.3",
  "description": "Pluggable control components for reliable AI agents using Hybrid model-program cooperation.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "assets/brand/rulora-logo-256.png",
    "assets/contact/wechat-qr.jpg",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Jeff <zzjeff1993.agent@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Buffalo2024/rulora.git"
  },
  "homepage": "https://github.com/Buffalo2024/rulora#readme",
  "bugs": {
    "url": "https://github.com/Buffalo2024/rulora/issues"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "example": "node examples/state-and-ownership/run.js",
    "lab:native-image": "node labs/native-image-report/run.js",
    "lab:stable-image": "node labs/stable-image-reproduction/run.js",
    "release:check": "node scripts/release-check.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "llm",
    "agent",
    "state-machine",
    "workflow",
    "agent-control",
    "loop-control",
    "output-validation",
    "reliable-agents",
    "openclaw",
    "hybrid"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
